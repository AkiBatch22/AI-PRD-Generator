# Docker Compose uses PostgreSQL. Local Python also accepts sqlite:///./copilot.db.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
SEED_DEMO=true
CORS_ORIGINS=http://localhost:3000
# Next.js server proxy (never put LLM secrets in NEXT_PUBLIC_* variables)
API_URL=http://127.0.0.1:8000
# Optional published images for: docker compose up -d --no-build
# BACKEND_IMAGE=ghcr.io/owner/repository-backend:sha-<full-commit-sha>
# FRONTEND_IMAGE=ghcr.io/owner/repository-frontend:sha-<full-commit-sha>
